{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "singleQuote": true,
  "semi": true,
  "trailingComma": "all",
  "printWidth": 100,
  "sortPackageJson": false,
  "ignorePatterns": [
    "node_modules",
    "dist",
    "build",
    "pnpm-lock.yaml",
    "**/.opencode/**",
    "logs.*.json",
    "drizzle/**"
  ]
}
